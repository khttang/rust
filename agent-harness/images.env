# Pinned build images, shared by validate-openshell.sh and test-in-container.sh.
# Digests are multi-arch indexes, so the same pin works on amd64 and arm64.
# To update: docker pull <tag>; docker inspect <tag> --format '{{index .RepoDigests 0}}'
# (sandbox.Dockerfile pins its debian:trixie-slim base separately.)

# Rust 1.95 = the minimum supported version (rig-core 0.43). Debian trixie.
RUST_IMAGE="rust:1.95@sha256:f49565f188ee00bc2a18dd418183f2c5f23ef7d6e691890517ed341a598f67c3"

# Debian packages, pinned to exact versions. cbmc pulls in gcc (its
# preprocessor); it is installed into RUST_IMAGE for tests and into the
# sandbox image.
CBMC_PACKAGE="cbmc=6.6.0-4"

# C library headers (<stdint.h>, <limits.h>, ...) for the sandbox image, so
# CBMC can preprocess real C files. Must equal the libc6 version in
# sandbox.Dockerfile's pinned base (2.41-12+deb13u4); RUST_IMAGE already ships
# its own matching libc6-dev. Debian drops superseded versions from its
# mirror, so when this stops installing, update the base digest and this pin
# together (the build fails loudly rather than drift).
LIBC_DEV_PACKAGE="libc6-dev=2.41-12+deb13u4"
