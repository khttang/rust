{"event":{"accepted":true,"checks":6,"kind":"accepted","report":{"cbmc":{"error":null,"evidence":22,"failing":[],"outcome":"verified","properties":1,"version":"CBMC 6.6.0 (cbmc-6.6.0)"},"checks":["bounds","pointer","div_by_zero","signed_overflow","undefined_shift","pointer_overflow"],"diff":"--- a/ring.c\n+++ b/ring.c\n@@ -3,6 +3,7 @@\n\n /* Store `value` at slot `head`; return the next slot. */\n int ring_put(int head, int value) {\n-  ring[head] = value;\n-  return (head + 1) % 4;\n+  unsigned int idx = (unsigned int)head & 3;\n+  ring[idx] = value;\n+  return (idx + 1) % 4;\n }\n","file":"ring.c","final_sha256":"62e3b5baaa42081ba04bb8a015b8b6f4eb1d428d97cd970ed97c5648b00007f3","function":"ring_put","original_sha256":"4fdf73e7d535791851ece6614a6da1a4d8baa260379537a889f895c3550a8fb0","total_tokens":17905,"turns":5,"unwind":4}},"hash":"86a4a65879ca8c76ec0824fd08a89663ad4e918f2a55acdb06ee0dabe0713b29","prev":"8c43bec06be4297d898b6ff21a2cfee992053222098fe8df3c1744716bacd880","seq":29,"ts_ms":1790871620707}
